// Trading Marketplace — Prisma schema
// Generated from the 17-table Excel/PostgreSQL reference workbook.
// Table/column names are preserved 1:1 in the database via @@map/@map;
// Prisma-facing model/field names use idiomatic PascalCase/camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums (12) — values reproduced exactly as documented; no CREATE TYPE was
// supplied in the source, so value order/spelling here is authoritative.
// ---------------------------------------------------------------------------

enum RoleType {
  buyer
  seller
  broker
  admin

  @@map("role_type")
}

enum UserStatus {
  active
  suspended
  deactivated

  @@map("user_status")
}

enum InviteStatus {
  pending
  accepted
  revoked

  @@map("invite_status")
}

enum ListingSide {
  SELL
  BUY

  @@map("listing_side")
}

enum ListingStatus {
  active
  price_expired
  na
  sold_out
  traded
  withdrawn

  @@map("listing_status")
}

// Grain-size grading. Starting list per founder; more values added later as needed.
enum QualityGrade {
  barik
  chota
  mota
  dardra
  small
  bold
  normal
  dry
  full_green
  medium
  standard
  madras
  imported
  stream
  sella
  parmal

  @@map("quality_grade")
}

enum NegotiationStatus {
  open
  closed
  declined
  expired

  @@map("negotiation_status")
}

enum OfferType {
  offer
  counter
  accept
  decline
  retract

  @@map("offer_type")
}

enum OfferStatus {
  pending
  accepted
  declined
  countered
  retracted
  expired
  auto_closed_price_drop
  sold_out
  back_in_stock

  @@map("offer_status")
}

enum TradeStatus {
  confirmed
  cancelled

  @@map("trade_status")
}

enum FreightStatus {
  active
  price_expired

  @@map("freight_status")
}

enum SourceKind {
  supplier
  freight

  @@map("source_kind")
}

// How a broker's default brokerage is computed. The commission model is still an
// open question (CLAUDE.md §10 #4), so it is optional on Broker.
enum CommissionType {
  percent // % of trade value
  per_bag // ₹ per bag
  flat // ₹ per trade

  @@map("commission_type")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model TosVersion {
  version       Int      @id
  effectiveDate DateTime @map("effective_date") @db.Date
  termsUrl      String   @map("terms_url")
  privacyUrl    String   @map("privacy_url")
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  acceptedByUsers AppUser[] @relation("UserTosVersion")

  @@map("tos_version")
}

model AppUser {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone               String     @unique
  name                String?
  firmName            String?    @map("firm_name")
  roles               RoleType[] @default([])
  city                String?
  defaultPaymentTerms Int?       @map("default_payment_terms")
  firmNotes           String?    @map("firm_notes")
  defaultWeightKg     Int?       @map("default_weight_kg")
  tosAcceptedVersion  Int?       @map("tos_accepted_version")
  tosAcceptedAt       DateTime?  @map("tos_accepted_at") @db.Timestamptz(6)
  invitedById         String?    @map("invited_by") @db.Uuid
  status              UserStatus @default(active)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  tosVersion   TosVersion? @relation("UserTosVersion", fields: [tosAcceptedVersion], references: [version], onDelete: SetNull)
  invitedBy    AppUser?    @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers AppUser[]   @relation("UserInvitedBy")

  invitesSent            Invite[]                @relation("InviteInvitedBy")
  otpVerifications       OtpVerification[]
  listings               Listing[]               @relation("ListingUser")
  negotiationsAsBuyer    Negotiation[]           @relation("NegotiationBuyer")
  negotiationsAsSeller   Negotiation[]           @relation("NegotiationSeller")
  offers                 Offer[]                 @relation("OfferByUser")
  buyerRequirements      BuyerRequirement[]      @relation("BuyerRequirementBuyer")
  recentlyViewedListings RecentlyViewedListing[] @relation("RecentlyViewedListingBuyer")
  brokersCreated         Broker[]                @relation("BrokerCreatedBy")
  brokersUpdated         Broker[]                @relation("BrokerUpdatedBy")
  tradesAsBuyer          Trade[]                 @relation("TradeBuyer")
  tradesAsSeller         Trade[]                 @relation("TradeSeller")
  tradesCancelled        Trade[]                 @relation("TradeCancelledByAdmin")
  freightRoutesUpdated   FreightRoute[]          @relation("FreightRouteUpdatedBy")
  settingsUpdated        Setting[]               @relation("SettingUpdatedBy")
  auditLogs              AuditLog[]              @relation("AuditLogActor")
  sourceTemplates        SourceTemplate[]        @relation("SourceTemplateOwner")
  refreshTokens          RefreshToken[]

  @@map("app_user")
}

model Invite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String
  invitedById String       @map("invited_by") @db.Uuid
  roleHint    RoleType?    @map("role_hint")
  status      InviteStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy AppUser @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([phone], map: "ix_invite_phone")
  @@index([status], map: "ix_invite_status")
  // Partial unique index (one open invite per phone) added via raw SQL in the
  // migration — see prisma/migrations/*/migration.sql (uq_invite_open_phone).
  @@map("invite")
}

model OtpVerification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "ix_otp_verification_user")
  @@index([expiresAt], map: "ix_otp_verification_expires")
  @@map("otp_verification")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      AppUser   @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_token")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model CommodityCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  commodities       Commodity[]
  listings          Listing[]
  buyerRequirements BuyerRequirement[]

  @@map("commodity_category")
}

model Commodity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category CommodityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  listings Listing[]
  trades   Trade[]

  @@unique([categoryId, name], map: "uq_commodity_category_id_name")
  @@map("commodity")
}

// ---------------------------------------------------------------------------
// Marketplace
// ---------------------------------------------------------------------------

model Listing {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  side             ListingSide
  userId           String        @map("user_id") @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  commodityId      String?       @map("commodity_id") @db.Uuid
  itemName         String        @map("item_name")
  quality          QualityGrade?
  quantityBags     Int           @map("quantity_bags")
  availabilityBags Int           @map("availability_bags")
  weightKg         Int?          @map("weight_kg")
  price            Decimal?      @db.Decimal(12, 2)
  currency         String        @default("INR") @db.Char(3)
  photoUrls        String[]      @map("photo_urls")
  videoUrls        String[]      @map("video_urls")
  moisture         String?
  color            String?
  size             String?
  paymentTerms     Int?          @map("payment_terms")
  notes            String?
  status           ListingStatus @default(active)
  priceValidUntil  DateTime?     @map("price_valid_until") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  user      AppUser           @relation("ListingUser", fields: [userId], references: [id], onDelete: Restrict)
  category  CommodityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  commodity Commodity?        @relation(fields: [commodityId], references: [id], onDelete: SetNull)

  negotiations           Negotiation[]
  recentlyViewedListings RecentlyViewedListing[]

  @@index([side, categoryId, status, price], map: "ix_listing_browse")
  @@index([userId, status], map: "ix_listing_by_user")
  // Partial index ix_listing_active (status) WHERE status = 'active' added via raw SQL.
  // Partial unique uq_listing_no_duplicate_sell (user_id, category_id, commodity_id,
  // weight_kg, quality) WHERE side = 'SELL' AND status IN ('active','na','price_expired'),
  // NULLS NOT DISTINCT, added via raw SQL in the migration.
  @@map("listing")
}

model Negotiation {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId          String            @map("listing_id") @db.Uuid
  buyerId            String            @map("buyer_id") @db.Uuid
  sellerId           String            @map("seller_id") @db.Uuid
  status             NegotiationStatus @default(open)
  buyerCountersUsed  Int               @default(0) @map("buyer_counters_used")
  sellerCountersUsed Int               @default(0) @map("seller_counters_used")
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   AppUser @relation("NegotiationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  AppUser @relation("NegotiationSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  offers Offer[]
  trade  Trade?

  @@index([buyerId, status], map: "ix_neg_by_buyer")
  @@index([sellerId, status], map: "ix_neg_by_seller")
  @@index([listingId], map: "ix_neg_listing")
  // Partial unique uq_neg_open (listing_id, buyer_id) WHERE status = 'open' added via raw SQL.
  @@map("negotiation")
}

model Offer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negotiationId String      @map("negotiation_id") @db.Uuid
  byUserId      String      @map("by_user_id") @db.Uuid
  price         Decimal     @db.Decimal(12, 2)
  bagsRequested Int         @map("bags_requested")
  type          OfferType
  status        OfferStatus @default(pending)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  byUser      AppUser     @relation("OfferByUser", fields: [byUserId], references: [id], onDelete: Restrict)

  @@index([negotiationId, createdAt], map: "ix_offer_neg")
  // Partial unique uq_offer_pending (negotiation_id) WHERE status = 'pending' added via raw SQL.
  @@map("offer")
}

model BuyerRequirement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  itemName       String   @map("item_name")
  weightPerBagKg Int?     @map("weight_per_bag_kg")
  targetPrice    Decimal? @map("target_price") @db.Decimal(12, 2)
  quantityBags   Int      @map("quantity_bags")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  buyer    AppUser           @relation("BuyerRequirementBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  category CommodityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId], map: "ix_buyer_requirement_category")
  @@index([buyerId, createdAt], map: "ix_buyer_requirement_buyer")
  @@map("buyer_requirement")
}

model RecentlyViewedListing {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  viewCount Int      @default(1) @map("view_count")

  buyer   AppUser @relation("RecentlyViewedListingBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([buyerId, listingId], map: "uq_recently_viewed_listing")
  @@index([buyerId, viewedAt(sort: Desc)], map: "ix_recently_viewed_listing_buyer")
  @@map("recently_viewed_listing")
}

// ---------------------------------------------------------------------------
// Trade
// ---------------------------------------------------------------------------

// Admin-managed broker list (the finite dropdown on the trade-accept screen, §4.6).
// Never hard-deleted: Trade.broker is ON DELETE SET NULL, so a delete would silently
// erase brokerage attribution from past trades — `active = false` instead.
model Broker {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phone          String          @unique
  commissionType CommissionType? @map("commission_type")
  commissionRate Decimal?        @map("commission_rate") @db.Decimal(10, 2)
  active         Boolean         @default(true)
  createdById    String          @map("created_by") @db.Uuid
  updatedById    String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy AppUser  @relation("BrokerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy AppUser? @relation("BrokerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  trades    Trade[]

  // CHECK ck_broker_commission (type and rate set together; rate >= 0; percent <= 100)
  // added via raw SQL in the broker_crud migration.
  @@index([active, name], map: "ix_broker_active_name")
  @@map("broker")
}

model Trade {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negotiationId      String      @unique @map("negotiation_id") @db.Uuid
  buyerId            String      @map("buyer_id") @db.Uuid
  sellerId           String      @map("seller_id") @db.Uuid
  commodityId        String?     @map("commodity_id") @db.Uuid
  quality            String?
  finalPrice         Decimal     @map("final_price") @db.Decimal(12, 2)
  quantityBags       Int         @map("quantity_bags")
  brokerId           String?     @map("broker_id") @db.Uuid
  brokerNameFreetext String?     @map("broker_name_freetext")
  isSelf             Boolean     @default(false) @map("is_self")
  status             TradeStatus @default(confirmed)
  confirmedAt        DateTime    @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  dealMsgSentAt      DateTime?   @map("deal_msg_sent_at") @db.Timestamptz(6)
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelledByAdminId String?     @map("cancelled_by_admin") @db.Uuid

  negotiation      Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Restrict)
  buyer            AppUser     @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller           AppUser     @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  commodity        Commodity?  @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  broker           Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  cancelledByAdmin AppUser?    @relation("TradeCancelledByAdmin", fields: [cancelledByAdminId], references: [id], onDelete: SetNull)

  @@index([buyerId, confirmedAt], map: "ix_trade_buyer")
  @@index([sellerId, confirmedAt], map: "ix_trade_seller")
  @@index([brokerId], map: "ix_trade_broker")
  @@map("trade")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model FreightRoute {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originName      String        @map("origin_name")
  destinationName String        @map("destination_name")
  priceLow        Decimal?      @map("price_low") @db.Decimal(12, 2)
  priceHigh       Decimal?      @map("price_high") @db.Decimal(12, 2)
  unit            String        @default("per_quintal")
  truckCapacity   String?       @map("truck_capacity")
  priceValidUntil DateTime?     @map("price_valid_until") @db.Timestamptz(6)
  status          FreightStatus @default(active)
  updatedById     String        @map("updated_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  updatedBy AppUser @relation("FreightRouteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  // Also has a DB-only unique index on (lower(origin_name), lower(destination_name)) —
  // uq_freight_route_origin_destination, see the freight_drop_origin_level migration.
  @@index([originName, destinationName, status], map: "ix_freight_route")
  @@map("freight_route")
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json     @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updatedByUser AppUser? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("setting")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String   @map("entity_id")
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor AppUser @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, createdAt], map: "ix_audit_entity")
  @@map("audit_log")
}

model SourceTemplate {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceKind  SourceKind @map("source_kind")
  ownerUserId String?    @map("owner_user_id") @db.Uuid
  version     Int        @default(1)
  columnMap   Json       @default("{}") @map("column_map") @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  owner AppUser? @relation("SourceTemplateOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@map("source_template")
}
